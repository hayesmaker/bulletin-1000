# Root for the SQLite database and uploaded/rendered media (default ./data)
DATA_DIR=./data

# Narration (ElevenLabs text to speech). The key stays on the server.
# Create a restricted key with Text to Speech and Voices (Read) only, and
# set a character limit on it in ElevenLabs.
ELEVENLABS_API_KEY=
# Model id (default eleven_multilingual_v2)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Comma-separated voice ids to offer (default: all the account's voices)
# ELEVENLABS_VOICES=
# Characters generated per 24 hours (default 20000); reused lines are free
# TTS_DAILY_CHARACTERS=20000
# Without a key, set to 1 for a stand-in voice (tones) to test narration
# TTS_FAKE=1

# Export: Chrome pages rendering in parallel (default half the cores, max 4)
# RENDER_PAGES=4
